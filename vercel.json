      "permanent": true
    },
    {
      "source": "/prakriti",
      "destination": "/#prakriti",
      "permanent": true
    },
    {
      "source": "/videshi",
      "destination": "/#videshi",
      "permanent": true
    },
    {
      "source": "/bhakti",
      "destination": "/#bhakti",
      "permanent": true
    },
    {
      "source": "/about-the-artist",
      "destination": "/#about",
      "permanent": true
    },
    {
